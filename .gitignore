# Runtime cache and transaction state
.own/

# Rust and cargo-fuzz build/test output
/target/
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Python caches and local analysis output
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local release output, logs and editor files
/dist/
/own-*.tar.gz
/own-*.tar.gz.sha256
/own-*.tar.gz.bundle
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store

# Local credentials are never source inputs
.env
.env.*
!.env.example

# Vendored package bytes must remain trackable, including ignored extensions.
!vendor/own/**
