{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "own.lock schema_version 1 — implemented TOML-to-JSON structure",
  "description": "Structural validation only. Integrity, canonical bytes, supported values and path safety are checked by own verify. This is not a certification of the absent normative specification.",
  "type": "object",
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schema_version", "vendor_files_sha256", "license_policy_sha256", "lock_digest"],
      "properties": {
        "schema_version": { "const": 1 },
        "own_version": { "type": "string" },
        "extractor_version": { "type": "string" },
        "license_policy_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "vendor_files_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "licenses_md_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "lock_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "package": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ecosystem", "version", "dir", "registry", "integrity", "tarball_sha256", "version_manifest_sha256", "provenance_level", "mode", "roots", "dependents", "license_expression", "license_policy", "license_files", "package_files_sha256", "file_count", "total_size"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ecosystem": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "dir": { "type": "string", "pattern": "^vendor/own/[^/]+$" },
          "registry": { "type": "string", "minLength": 1 },
          "integrity": { "type": "string", "minLength": 1 },
          "tarball_sha256": { "$ref": "#/$defs/sha256" },
          "version_manifest_sha256": { "$ref": "#/$defs/sha256" },
          "provenance_level": { "type": "string", "minLength": 1 },
          "provenance_source": { "type": "string" },
          "mode": { "type": "string", "minLength": 1 },
          "roots": { "$ref": "#/$defs/strings" },
          "dependents": { "$ref": "#/$defs/strings" },
          "license_expression": { "type": "string" },
          "license_selected": { "type": "string" },
          "license_policy": { "type": "string", "minLength": 1 },
          "license_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          },
          "package_files_sha256": { "$ref": "#/$defs/sha256" },
          "file_count": { "type": "integer", "minimum": 0 },
          "total_size": { "type": "integer", "minimum": 0 },
          "diamond_resolution": { "type": "string" },
          "unified_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["dependent", "range"],
              "properties": {
                "dependent": { "type": "string", "minLength": 1 },
                "range": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "decision": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "strategy", "dependents"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "strategy": { "type": "string", "minLength": 1 },
          "dependents": { "$ref": "#/$defs/strings" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "strings": { "type": "array", "items": { "type": "string" } }
  }
}
